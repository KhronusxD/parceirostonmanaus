---
// Catálogo das maquininhas do Ton TOP (só T3 e T3 Smart; preços do Ton TOP, oferta Black Friday).
const models = [
  {
    name: 'T3',
    subtitle: '3G, Wi-Fi, impressora e teclado',
    price: '90,30',
    oldPrice: '391,92',
    parcela: '7,52',
    badge: 'Black Friday · −77%',
    img: '/ai-t3.webp',
    desc: 'Impressora térmica e teclado pra digitar valor rápido. Balcão, loja e restaurante.'
  },
  {
    name: 'T3 Smart',
    subtitle: 'Android embarcado e tela grande',
    price: '132,30',
    oldPrice: '671,43',
    parcela: '11,00',
    badge: 'Black Friday · −80%',
    img: '/ai-t3-smart.webp',
    desc: 'O melhor da linha. Android, tela ampla e impressora. Operação rápida e fluida.'
  }
];
---
<section id="catalogo-top" class="relative py-24 md:py-32 bg-paper-soft">
  <div class="container-x">
    <div class="max-w-2xl mx-auto text-center">
      <span class="eyebrow">As maquininhas do TOP</span>
      <h2 class="mt-3 text-3xl md:text-5xl font-bold text-ink-950 leading-[1.05]">
        Escolha a sua com a condição Ton TOP.
      </h2>
      <p class="mt-4 text-ink-500 text-base md:text-lg">
        No TOP a adesão é um pouco maior, mas a taxa é menor — no fim do mês, o aparelho se paga sozinho.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-3xl mx-auto">
      {models.map((m) => {
        const wa = 'https://wa.me/5592984603260?text=' + encodeURIComponent(
          `Olá! Quero a condição Ton TOP com a maquininha ${m.name}.`
        );
        return (
        <article class="card p-6 md:p-7 flex flex-col relative overflow-hidden">
          <div class="aspect-square w-full rounded-xl bg-paper mb-6 flex items-center justify-center overflow-hidden">
            <img src={m.img} alt={`Maquininha Ton ${m.name}`} class="max-h-full max-w-full object-contain" loading="lazy" />
          </div>

          <div>
            <h3 class="text-2xl font-semibold text-ink-950">{m.name}</h3>
            <p class="text-sm text-ton-deep mt-0.5">{m.subtitle}</p>
          </div>

          <p class="mt-4 text-sm text-ink-500 leading-relaxed flex-1">{m.desc}</p>

          <div class="mt-6 pt-6 border-t border-line">
            <div class="text-xs text-ink-500">a partir de</div>
            <div class="text-sm text-ink-400 line-through leading-none mt-0.5">R$ {m.oldPrice}</div>
            <div class="font-display text-3xl font-bold text-ink-950 leading-tight">
              <span>R$ </span><span>{m.price}</span>
            </div>
            <div class="text-xs text-ink-500 mt-1">ou 12x de R$ {m.parcela} sem juros</div>
            <span class="inline-block mt-1.5 text-[10px] font-bold uppercase tracking-wide text-ton-deep bg-ton-soft rounded-full px-2 py-0.5">{m.badge}</span>
          </div>

          <a href={wa} target="_blank" rel="noopener" class="btn btn-wa mt-5 w-full" data-cta={`top-modelo-${m.name.toLowerCase().replace(/\s+/g,'-')}-wa`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.2-.7.2-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1s-1.2-.4-2.3-1.4c-.8-.7-1.4-1.6-1.5-1.9-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4s-1 1-1 2.5.9 2.9 1.1 3.1c.1.2 2 3.1 4.9 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.2-.7-.4zM12 2.2C6.6 2.2 2.2 6.6 2.2 12c0 1.7.4 3.3 1.2 4.7L2 22l5.5-1.4C8.9 21.4 10.4 21.8 12 21.8c5.4 0 9.8-4.4 9.8-9.8S17.4 2.2 12 2.2z"/></svg>
            Quero a {m.name}
          </a>
        </article>
      )})}
    </div>

    <p class="mt-8 text-center text-xs text-ink-400 max-w-xl mx-auto">
      Oferta Black Friday por tempo limitado. Taxas a partir de 0,79% e Pix 0% ilimitado. Venda em até 21x.
    </p>
  </div>
</section>
