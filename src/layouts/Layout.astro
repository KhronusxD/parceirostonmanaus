---
import '../styles/global.css';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';

export interface Props {
  title?: string;
  description?: string;
  path?: string;
  videoPreloadUrl?: string;
}

const {
  title = 'Parceiro Autorizado Ton em Manaus | Pronta Entrega, Loja no Centro',
  description = 'Maquininha Ton em Manaus com entrega no mesmo dia. Duas lojas físicas do Parceiro Autorizado Ton. T1, T2, T3 e T3 Smart com Pix 0% e atendimento humano. Fale no WhatsApp.',
  path = '/',
  videoPreloadUrl = ''
} = Astro.props;

const canonical = new URL(path, Astro.site ?? 'https://parceirostonmanaus.com.br').toString();
const ogImage = new URL('/img/og-cover.jpg', Astro.site ?? 'https://parceirostonmanaus.com.br').toString();

// Google Ads
const GTAG_ID = 'AW-18359105439';
const CONV_LEAD = 'AW-18359105439/BMyzCNSPstscEJ_vprJE'; // conversão "Lead - WhatsApp"

// Meta (pixel "Parceiros Ton Manaus" / Ton #1) — o mesmo dos eventos do GyreHub
const META_PIXEL = '882829890919527';
// GyreHub: workspace Lojas Ton Manaus + um link rastreado por página. O slug vai no pixel
// do GyreHub e como [REF:] no fim de toda mensagem de WhatsApp (liga a conversa à página).
const GH_WS = '0bbab1f9-02d0-435f-aaf0-998d35946dea';
const GH_REFS: Record<string, string> = { '/links': 'iqihyh', '/ton-black': 'y4yn4h' };
const ghRef = GH_REFS[path] ?? 'v8aqbf'; // home (e privacidade/termos)
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FAFAF7" />
    <meta name="robots" content="index,follow" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Parceiro Autorizado Ton Manaus" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    { videoPreloadUrl && (
      <>
        <link rel="preload" href={videoPreloadUrl} as="video" type="video/mp4" crossorigin="anonymous" fetchpriority="high" media="(min-width: 1024px)" />
        <link rel="preconnect" href={new URL(videoPreloadUrl).origin} crossorigin />
      </>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    />

    { GTAG_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GTAG_ID}`}></script>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${GTAG_ID}');

          // Conversão de lead: dispara em qualquer clique que leve ao WhatsApp e no envio do formulário.
          window.__tonConvLead = '${CONV_LEAD}';
          window.tonLead = function(extra){
            try {
              gtag('event', 'conversion', Object.assign({ send_to: window.__tonConvLead }, extra || {}));
            } catch (e) {}
          };
          // Delegação global: pega todos os links wa.me e botões [data-cta] do site de uma vez.
          document.addEventListener('click', function (e) {
            var t = e.target;
            if (!t || !t.closest) return;
            // [data-gh-interno] = link criado pelo formulário/quiz, que já chama tonLead() sozinho
            if (t.closest('a[href*="wa.me"]:not([data-gh-interno]), [data-cta]')) window.tonLead();
          }, true);
        `}></script>
      </>
    )}

    <script is:inline set:html={`
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
      (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '${META_PIXEL}'); fbq('track', 'PageView');

      // Põe o [REF:slug] no fim da mensagem do WhatsApp (uma vez só).
      window.TON_REF = '${ghRef}';
      window.tonZapUrl = function (url) {
        try {
          if (/\\[REF:|%5BREF%3A/i.test(url)) return url;
          var tag = '[REF:' + window.TON_REF + ']';
          var i = url.indexOf('?text=');
          if (i < 0) return url + (url.indexOf('?') < 0 ? '?' : '&') + 'text=' + encodeURIComponent('Olá! Vim pelo site.\\n\\n' + tag);
          var base = url.slice(0, i), resto = url.slice(i + 6), k = resto.indexOf('&');
          var txt = decodeURIComponent((k < 0 ? resto : resto.slice(0, k)).replace(/\\+/g, ' '));
          return base + '?text=' + encodeURIComponent(txt + '\\n\\n' + tag) + (k < 0 ? '' : resto.slice(k));
        } catch (e) { return url; }
      };
      // Formulário e quiz abrem o WhatsApp por aqui: um <a data-whatsapp> pra o pixel do
      // GyreHub registrar o clique. Eles mesmos mandam o Lead, então não sai Contact.
      window.tonAbrirZap = function (url, novaAba) {
        var a = document.createElement('a');
        a.href = window.tonZapUrl(url);
        a.setAttribute('data-whatsapp', ''); a.setAttribute('data-gh-interno', '');
        if (novaAba) { a.target = '_blank'; a.rel = 'noopener'; }
        a.textContent = 'WhatsApp'; a.style.display = 'none';
        document.body.appendChild(a); a.click();
      };
      // Todo link wa.me do site: ganha o [REF:] antes de abrir e manda Contact.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a[href*="wa.me/"]');
        if (!a) return;
        a.href = window.tonZapUrl(a.href);
        if (!a.hasAttribute('data-gh-interno') && window.fbq) fbq('track', 'Contact');
      }, true);
    `}></script>
    <script is:inline async src={`https://gyrehub.com.br/pixel.js?id=${GH_WS}&link=${ghRef}`}></script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Loja Parceira Ton Manaus",
      "description": description,
      "image": ogImage,
      "url": canonical,
      "telephone": "+5592984603260",
      "openingHoursSpecification": [{
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
        "opens": "09:00", "closes": "17:00"
      }],
      "sameAs": ["https://wa.me/5592984603260"],
      "location": [
        {
          "@type": "Place",
          "name": "Unidade Centro",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Av. Eduardo Ribeiro, 520, Sala 02, Ed. Manaus Shopping Center",
            "addressLocality": "Manaus",
            "addressRegion": "AM",
            "postalCode": "69010-000",
            "addressCountry": "BR"
          },
          "geo": { "@type": "GeoCoordinates", "latitude": -3.130192, "longitude": -60.023093 }
        },
        {
          "@type": "Place",
          "name": "Unidade Cidade Nova",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Rua Felix Valois, 41, Cidade Nova",
            "addressLocality": "Manaus",
            "addressRegion": "AM",
            "addressCountry": "BR"
          }
        }
      ]
    })}></script>
  </head>
  <body>
    <slot />
    <FloatingWhatsApp />

    <script is:inline>
      // Store status — atualiza [data-store-status] com "Loja aberta agora" / "Loja fechada agora"
      // e [data-store-dot] com bg-ton (verde) / bg-red-500 (vermelho).
      // Fuso horário de Manaus (America/Manaus, UTC-4, sem horário de verão).
      // Horário comercial: Segunda a sexta, 9h às 17h.
      (function () {
        function isStoreOpen() {
          try {
            var now = new Date();
            var fmt = new Intl.DateTimeFormat('en-US', {
              timeZone: 'America/Manaus',
              weekday: 'short',
              hour: '2-digit',
              hour12: false
            });
            var parts = fmt.formatToParts(now);
            var wd = parts.find(function (p) { return p.type === 'weekday'; }).value; // Sun, Mon, ...
            var hour = parseInt(parts.find(function (p) { return p.type === 'hour'; }).value, 10);
            if (wd === 'Sat' || wd === 'Sun') return false;
            return hour >= 9 && hour < 17;
          } catch (e) { return null; }
        }
        function apply() {
          var open = isStoreOpen();
          if (open === null) return;
          document.querySelectorAll('[data-store-status]').forEach(function (el) {
            el.textContent = open ? 'Loja aberta agora' : 'Loja fechada agora';
          });
          document.querySelectorAll('[data-store-dot]').forEach(function (el) {
            if (open) {
              el.classList.remove('bg-red-500');
              el.classList.add('bg-ton');
              el.classList.add('animate-pulse');
            } else {
              el.classList.remove('bg-ton');
              el.classList.remove('animate-pulse');
              el.classList.add('bg-red-500');
            }
          });
        }
        apply();
        setInterval(apply, 60000);
      })();
    </script>
  </body>
</html>
